# Build context is the monorepo root; keep it to sources the app images need.
**/node_modules
**/.svelte-kit
**/build
**/coverage
**/.output
**/.wrangler
**/.fallow
**/.claude
.git
.github

# OS
**/.DS_Store
**/Thumbs.db

# Env (never ship real env files into the build context)
**/.env
**/.env.*
!**/.env.example

# Vite
**/vite.config.js.timestamp-*
**/vite.config.ts.timestamp-*

# SQLite
**/data
**/*.db
**/*.sqlite

**/fly.toml
