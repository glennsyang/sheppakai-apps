{
	"name": "synapse",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt --no-error-on-unmatched-pattern",
		"fmt:check": "oxfmt --check --no-error-on-unmatched-pattern",
		"lint": "oxlint && pnpm run check:dead-code",
		"lint:fix": "oxlint --fix",
		"lint:github": "oxlint --format=github",
		"check:redirect-throws": "node ../../scripts/check-redirect-throws.mjs",
		"check:dead-code": "fallow dead-code --format human",
		"check:all": "pnpm run fmt && pnpm run lint && pnpm run test",
		"test:e2e": "playwright test",
		"test": "pnpm run test:unit -- --run",
		"test:unit": "vitest",
		"test:ci": "pnpm run test:unit -- --run && pnpm run test:coverage",
		"test:coverage": "vitest run --coverage",
		"update-deps": "pnpm outdated || pnpm update",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate"
	},
	"dependencies": {
		"@better-auth/api-key": "catalog:",
		"@fontsource/zen-kaku-gothic-new": "^5.3.0",
		"@getbrevo/brevo": "catalog:",
		"@sentry/sveltekit": "catalog:",
		"@sheppakai/logger": "workspace:*",
		"@sheppakai/shared": "workspace:*",
		"better-auth": "catalog:",
		"better-sqlite3": "catalog:",
		"canvas-confetti": "catalog:",
		"d3-scale": "catalog:",
		"d3-shape": "catalog:",
		"drizzle-orm": "catalog:",
		"markdown-it": "^15.0.2",
		"mode-watcher": "catalog:",
		"sveltekit-rate-limiter": "catalog:"
	},
	"devDependencies": {
		"@flydotio/dockerfile": "catalog:",
		"@internationalized/date": "catalog:",
		"@lucide/svelte": "catalog:",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tanstack/svelte-table": "catalog:",
		"@tanstack/table-core": "catalog:",
		"@types/better-sqlite3": "catalog:",
		"@types/canvas-confetti": "catalog:",
		"@types/d3-scale": "catalog:",
		"@types/d3-shape": "catalog:",
		"@types/markdown-it": "^14.2.0",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"bits-ui": "catalog:",
		"clsx": "catalog:",
		"dotenv": "^18.0.5",
		"drizzle-kit": "catalog:",
		"embla-carousel-svelte": "^8.6.0",
		"fallow": "catalog:",
		"layerchart": "catalog:",
		"lefthook": "catalog:",
		"lint-staged": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-dnd-action": "^0.9.80",
		"svelte-sonner": "catalog:",
		"sveltekit-superforms": "catalog:",
		"tailwind-merge": "catalog:",
		"tailwind-variants": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"typescript": "catalog:",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
